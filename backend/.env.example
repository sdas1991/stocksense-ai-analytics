# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres-db:5432/stocksense

# Redis Cache
REDIS_URL=redis://redis-cache:6379/0
REDIS_ENABLED=True

# AWS Configuration (Optional - for Bedrock AI features)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
BEDROCK_MODEL_ID=amazon.titan-text-lite-v1

# Stock Data API Keys (All Optional - app works without them)
# Free tier APIs (recommended to configure for best coverage)
IEX_CLOUD_API_KEY=        # Free tier: 100 req/sec - https://iexcloud.io
FINNHUB_API_KEY=           # Free tier: 60 req/min - https://finnhub.io
POLYGON_API_KEY=           # Free tier: 5 req/min - https://polygon.io
TWELVE_DATA_API_KEY=       # Free tier: 8 req/min - https://twelvedata.com
ALPHA_VANTAGE_API_KEY=     # Free tier: 5 req/min - https://www.alphavantage.co

# News API (Optional)
NEWS_API_KEY=              # https://newsapi.org

# Application Settings
ENV=development
DEBUG=True
APP_NAME=StockSense AI
APP_VERSION=2.0.0

# Data Provider Priority (used in order if multiple configured)
DATA_PROVIDER_PRIORITY=["yahoo", "iex", "polygon", "finnhub", "twelvedata", "alphavantage"]
