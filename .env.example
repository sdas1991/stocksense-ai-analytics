# StockSense AI - Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres-db:5432/stocksense

# Redis Cache
REDIS_URL=redis://redis-cache:6379/0
REDIS_ENABLED=True

# AWS Configuration (Optional - for Bedrock AI features)
# Get these from AWS Console → IAM → Users → Security Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
BEDROCK_MODEL_ID=amazon.titan-text-lite-v1

# Stock Data API Keys (All Optional - app works without them)
# The app uses Yahoo Finance by default (no key required)
# Add API keys below to enable additional data sources:

# IEX Cloud (Free tier: 100 requests/second)
# Sign up: https://iexcloud.io
IEX_CLOUD_API_KEY=

# Finnhub (Free tier: 60 requests/minute)
# Sign up: https://finnhub.io
FINNHUB_API_KEY=

# Polygon.io (Free tier: 5 requests/minute)
# Sign up: https://polygon.io
POLYGON_API_KEY=

# Twelve Data (Free tier: 8 requests/minute, 800/day)
# Sign up: https://twelvedata.com
TWELVE_DATA_API_KEY=

# Alpha Vantage (Free tier: 5 requests/minute, 500/day)
# Sign up: https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# News API (Optional)
# Sign up: https://newsapi.org
NEWS_API_KEY=

# Application Settings
ENV=development
DEBUG=True
APP_NAME=StockSense AI
APP_VERSION=2.0.0

# Data Provider Priority (providers are tried in this order)
DATA_PROVIDER_PRIORITY=["yahoo", "iex", "polygon", "finnhub", "twelvedata", "alphavantage"]
