# Production Environment Configuration
# Copy this file to .env.prod and update with your production values

# Database Configuration (REQUIRED)
POSTGRES_USER=stocksense_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=stocksense_prod

# Redis Configuration (REQUIRED)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Application Security (REQUIRED)
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_HERE

# AWS Configuration (Optional - for Bedrock AI)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Application Settings
ENV=production
DEBUG=False
LOG_LEVEL=INFO
MAX_WORKERS=4

# Domain Configuration (Update with your domain)
DOMAIN=yourdomain.com
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Email Configuration (Optional - for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# API Keys (Optional - for premium features)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=

# Monitoring (Optional)
SENTRY_DSN=
